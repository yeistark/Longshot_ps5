+/* ---- a profile of the live blocks (ps5_heap_profile): bytes and counts by size class, and the blocks of 128 KiB and more
+ * with the callers that asked for them, to see what a title's heap holds when the pool is short ---- */
+#define PROF_CLASSES 28
+#define PROF_BIG ((size_t)128 << 10)
+#define PROF_SLOTS 65536
+#define PROF_SMALL_MIN ((size_t)4 << 10)
+#define PROF_SAMPLE 16
+#define PROF_FRAMES 5
+struct prof_site {
+   const void *pointer;
+   size_t bytes;
+   void *frames[PROF_FRAMES];
+};
+static long prof_bytes[PROF_CLASSES], prof_count[PROF_CLASSES];
+static struct prof_site prof_sites[PROF_SLOTS];
+static volatile int prof_lock;
+static unsigned long prof_lost;
+static volatile int prof_sample_on;   /* blocks under 128 KiB are sampled only once the title asks (ps5_heap_profile_enable) */
+
+void
+ps5_heap_profile_enable(int on)
+{
+   __atomic_store_n(&prof_sample_on, on, __ATOMIC_RELAXED);
+}
+
+static int
+prof_class(size_t bytes)
+{
+   int k = 0;
+   while (bytes > 31 && k < PROF_CLASSES - 1) {
+      bytes >>= 1;
+      k++;
+   }
+   return k; /* class k: [2^(k+5), 2^(k+6)) bytes, class 0 below 64 */
+}
+
+static void
+prof_take(void)
+{
+   while (__atomic_exchange_n(&prof_lock, 1, __ATOMIC_ACQUIRE))
+      ;
+}
+
+static void
+prof_drop(void)
+{
+   __atomic_store_n(&prof_lock, 0, __ATOMIC_RELEASE);
+}
+
+static unsigned
+prof_hash(const void *pointer)
+{
+   uintptr_t x = (uintptr_t)pointer >> 4;
+   x ^= x >> 17;
+   x *= 0x9e3779b97f4a7c15ull;
+   return (unsigned)(x >> 40) % PROF_SLOTS;
+}
+
+static void
+prof_add(void *pointer, void *frame)
+{
+   if (!pointer)
+      return;
+   const size_t bytes = mspace_usable_size(pointer);
+   const int k = prof_class(bytes);
+   __atomic_fetch_add(&prof_bytes[k], (long)bytes, __ATOMIC_RELAXED);
+   __atomic_fetch_add(&prof_count[k], 1, __ATOMIC_RELAXED);
+   if (bytes < PROF_BIG && (!__atomic_load_n(&prof_sample_on, __ATOMIC_RELAXED) || bytes < PROF_SMALL_MIN ||
+                            (((uintptr_t)pointer >> 4) % PROF_SAMPLE) != 0))
+      return;
+   struct prof_site site = {.pointer = pointer, .bytes = bytes};
+   void **fp = frame;
+   for (int i = 0; i < PROF_FRAMES && fp; i++) {
+      site.frames[i] = fp[1];
+      void **next = fp[0];
+      if (!next || ((uintptr_t)next & 7) || next <= fp || (uintptr_t)next - (uintptr_t)fp > ((uintptr_t)1 << 20))
+         break;
+      fp = next;
+   }
+   prof_take();
+   unsigned i = prof_hash(pointer);
+   for (unsigned n = 0; n < PROF_SLOTS; n++, i = (i + 1) % PROF_SLOTS) {
+      if (!prof_sites[i].pointer || prof_sites[i].pointer == (const void *)1) {
+         prof_sites[i] = site;
+         prof_drop();
+         return;
+      }
+   }
+   prof_lost++;
+   prof_drop();
+}
+
+static void
+prof_remove(void *pointer)
+{
+   if (!pointer)
+      return;
+   const size_t bytes = mspace_usable_size(pointer);
+   const int k = prof_class(bytes);
+   __atomic_fetch_sub(&prof_bytes[k], (long)bytes, __ATOMIC_RELAXED);
+   __atomic_fetch_sub(&prof_count[k], 1, __ATOMIC_RELAXED);
+   if (bytes < PROF_BIG && (bytes < PROF_SMALL_MIN || (((uintptr_t)pointer >> 4) % PROF_SAMPLE) != 0))
+      return;
+   if (bytes < PROF_BIG && !__atomic_load_n(&prof_sample_on, __ATOMIC_RELAXED))
+      return;
+   prof_take();
+   unsigned i = prof_hash(pointer);
+   for (unsigned n = 0; n < PROF_SLOTS; n++, i = (i + 1) % PROF_SLOTS) {
+      if (prof_sites[i].pointer == pointer) {
+         prof_sites[i].pointer = (const void *)1;
+         break;
+      }
+      if (!prof_sites[i].pointer)
+         break;
+   }
+   prof_drop();
+}
+
+/* Fills up to max lines of 192 bytes: the size classes with live blocks, then the callers holding the most in blocks of
+ * 128 KiB and more. Returns the count. Callers' addresses are the title's, to be looked up in its map. */
+int
+ps5_heap_profile(char (*lines)[192], int max)
+{
+   int n = 0;
+   for (int k = 0; k < PROF_CLASSES && n < max; k++) {
+      const long count = __atomic_load_n(&prof_count[k], __ATOMIC_RELAXED);
+      if (count <= 0)
+         continue;
+      snprintf(lines[n++], 192, "heap profile: blocks of %lu-%lu KiB: %ld live, %ld MiB (%ld KiB)",
+               (unsigned long)(32ul << k) / 1024, (unsigned long)(64ul << k) / 1024, count,
+               __atomic_load_n(&prof_bytes[k], __ATOMIC_RELAXED) >> 20,
+               __atomic_load_n(&prof_bytes[k], __ATOMIC_RELAXED) >> 10);
+   }
+   struct group {
+      void *frames[PROF_FRAMES];
+      size_t bytes, largest;
+      unsigned count;
+   };
+   static struct group groups[512];
+   int ng = 0;
+   prof_take();
+   for (unsigned i = 0; i < PROF_SLOTS; i++) {
+      const struct prof_site *e = &prof_sites[i];
+      if (!e->pointer || e->pointer == (const void *)1)
+         continue;
+      int g = 0;
+      for (; g < ng; g++)
+         if (!memcmp(groups[g].frames, e->frames, sizeof e->frames))
+            break;
+      if (g == ng) {
+         if (ng == 512)
+            continue;
+         memset(&groups[ng], 0, sizeof groups[ng]);
+         memcpy(groups[ng].frames, e->frames, sizeof e->frames);
+         ng++;
+      }
+      const unsigned weight = e->bytes < PROF_BIG ? PROF_SAMPLE : 1; /* (blocks under 128 KiB: one in 16 is kept) */
+      groups[g].bytes += e->bytes * weight;
+      groups[g].count += weight;
+      if (e->bytes > groups[g].largest)
+         groups[g].largest = e->bytes;
+   }
+   const unsigned long lost = prof_lost;
+   prof_drop();
+   for (int shown = 0; shown < 30 && n < max; shown++) {
+      int best = -1;
+      for (int g = 0; g < ng; g++)
+         if (groups[g].bytes && (best < 0 || groups[g].bytes > groups[best].bytes))
+            best = g;
+      if (best < 0)
+         break;
+      snprintf(lines[n++], 192, "heap profile: big: %zu KiB in %u blocks (largest %zu KiB) from %p %p %p %p %p",
+               groups[best].bytes >> 10, groups[best].count, groups[best].largest >> 10, groups[best].frames[0],
+               groups[best].frames[1], groups[best].frames[2], groups[best].frames[3], groups[best].frames[4]);
+      groups[best].bytes = 0;
+   }
+   if (lost && n < max)
+      snprintf(lines[n++], 192, "heap profile: %lu big blocks not tracked (table full)", lost);
+   return n;
+}
